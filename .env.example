# MASJIDOASIS — Environment Variable Placeholders
# Copy to .env (NOT committed) and fill in real values on each environment.
# See docs/adr/ADR-001-stack-selection.md section 7.

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Postgres 16) ---
DATABASE_URL=postgresql://user:password@localhost:5432/masjidoasis?schema=public

# --- Cache / Queue broker (Redis 7) ---
REDIS_URL=redis://localhost:6379
BULLMQ_REDIS_URL=redis://localhost:6379

# --- Auth (NextAuth v5 / Auth.js) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=

# --- OTP HP provider ---
OTP_PROVIDER=fonnte
OTP_API_KEY=

# --- Payment (Midtrans) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Shipping (KiriminAja) ---
KIRIMINAJA_API_KEY=

# --- WhatsApp / Email blast ---
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_API_KEY=

# --- Object storage (S3-compatible) ---
STORAGE_DISK=s3
STORAGE_ENDPOINT=
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Observability ---
PRISMA_LOG_LEVEL=warn
SENTRY_DSN=
