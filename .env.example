# MASJIDOASIS — Environment Variable Placeholders
# Copy to .env (NOT committed) and fill real values per environment.
# Reference: docs/env-vars.md and docs/adr/ADR-001-stack-selection.md §7.
#
# Rules:
#   - NEVER commit real secrets. .env is gitignored (.gitignore: .env*).
#   - Production secrets live in the deploy host's secret manager (Vercel/Doppler/SOPS/etc).
#   - All required vars are validated at boot by src/lib/env.ts.

# ─── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database (Postgres 16, Prisma) ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/masjidoasis?schema=public

# ─── Cache / Queue broker (Redis 7, BullMQ) ────────────────────────────────────
REDIS_URL=redis://localhost:6379
BULLMQ_REDIS_URL=redis://localhost:6379

# ─── Auth (NextAuth v5 / Auth.js) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-random-32-byte-base64
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=replace-with-random-32-byte-base64

# ─── OTP HP provider ───────────────────────────────────────────────────────────
OTP_PROVIDER=fonnte
OTP_API_KEY=

# ─── Payment (Midtrans) ────────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ─── Shipping (KiriminAja) ─────────────────────────────────────────────────────
KIRIMINAJA_API_KEY=

# ─── WhatsApp blast ────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_KEY=

# ─── Email blast ───────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=

# ─── Object storage (S3-compatible) ────────────────────────────────────────────
STORAGE_DISK=s3
STORAGE_ENDPOINT=
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ─── Observability ─────────────────────────────────────────────────────────────
PRISMA_LOG_LEVEL=warn
SENTRY_DSN=
